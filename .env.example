# ============================================================
#  Florería Los Lirios — Variables de entorno del frontend
#  Copiar a .env.local para desarrollo local
#  Las variables VITE_* son públicas (no poner secretos aquí)
# ============================================================

# URL base del backend Node (SIN "/api" al final si tu api.js ya lo agrega)
# Desarrollo local:
VITE_API_URL=http://localhost:8000
# Producción (URL que te da Render):
# VITE_API_URL=https://floreria-los-lirios-api.onrender.com

# Llave PÚBLICA de Culqi (sandbox para desarrollo)
VITE_CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp del negocio (sin el +)
VITE_WHATSAPP=51935758497

# Número Yape para el QR
VITE_YAPE_NUMBER=935758497
